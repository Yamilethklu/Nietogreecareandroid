{
  "expo": {
    "name": "Nieto Green Care",
    "slug": "nieto-green-care-android",
    "scheme": "nietogreencare",
    "version": "1.1.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#dcfce7"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos de trabajos para la galería.",
          "cameraPermission": "Permite tomar fotos de trabajos terminados."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4332"
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {}
    },
    "android": {
      "package": "com.nietogreencare.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dcfce7"
      }
    }
  }
}